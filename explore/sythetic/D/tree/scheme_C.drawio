        <mxCell id="formula_s1" value="&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;μ₁(MIC) = 0, &amp;nbsp; MIC ≤ 0.16&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (MIC−0.16)/0.83, &amp;nbsp; 0.16 &amp;lt; MIC &amp;lt; 0.83&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 1, &amp;nbsp; MIC ≥ 0.83&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="603" y="241" width="280" height="42" as="geometry" />
        </mxCell>
        <mxCell id="formula_s2" value="&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;μ₂ = min(μ_ρ, μ_r)&lt;br&gt;μ_ρ(|ρ|) = 0, |ρ|≤0.69&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(|ρ|−0.69)/0.30&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1, |ρ|≥0.99&lt;br&gt;μ_r(|r|) = 0, |r|≤0.70&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(|r|−0.70)/0.29&amp;nbsp; &amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1,&amp;nbsp;&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: rgb(102, 102, 102);&quot;&gt;|r|≥0.99&lt;/i&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="348" y="327" width="340" height="96" as="geometry" />
        </mxCell>
        <mxCell id="formula_s3" value="&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;μ₃(|ρ|) = 0, &amp;nbsp; |ρ| ≤ 0.86&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (|ρ|−0.86)/0.13, &amp;nbsp; 0.86 &amp;lt; |ρ| &amp;lt; 0.99&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 1, &amp;nbsp; |ρ| ≥ 0.99&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="-69" y="532" width="260" height="42" as="geometry" />
        </mxCell>
        <mxCell id="formula_s4" value="&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;μ₄ = min(μ_r, μ_bic)&lt;br&gt;μ_r(|r|) = 0, |r|≤0.92&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(|r|−0.92)/0.07&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1, |r|≥0.99&lt;br&gt;μ_bic(ΔBIC) = 1, ΔBIC≤0&amp;nbsp; &amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;1−ΔBIC/12&amp;nbsp;&amp;nbsp;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i style=&quot;font-size: 9px; color: rgb(102, 102, 102);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;0, ΔBIC≥12&lt;/i&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="51" y="642" width="210.25" height="101" as="geometry" />
        </mxCell>
        <mxCell id="alpha_def" value="&lt;b style=&quot;font-size:10px;color:#333&quot;&gt;Fuzzy membership&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px;color:#666&quot;&gt;μ(x) = { 0, x ≤ L;&amp;nbsp; (x−L)/(U−L), L &amp;lt; x &amp;lt; U;&amp;nbsp; 1, x ≥ U }&lt;br&gt;α-cut: μ ≥ 0.5 → Yes, &amp;nbsp;μ &amp;lt; 0.5 → No&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#7986CB;strokeWidth=1;fontSize=9;fontColor=#333333;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="-87" y="136" width="300" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
