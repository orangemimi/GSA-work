t;/td&gt;&lt;td style=&quot;color:#2468d8&quot;&gt;−&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="1202" width="480" height="205" as="geometry"/></mxCell>
        <mxCell id="votearrow" value="Majority&lt;br&gt;vote" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.4;arrowSize=0.4;fillColor=#111111;strokeColor=#111111;fontColor=#111111;fontSize=13;labelPosition=center;verticalLabelPosition=top;verticalAlign=bottom;" parent="1" vertex="1"><mxGeometry x="790" y="1270" width="90" height="45" as="geometry"/></mxCell>
        <mxCell id="consensus" value="&lt;b&gt;Consensus&lt;/b&gt;&lt;br&gt;sign at &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FF2D2D&quot; size=&quot;6&quot;&gt;●　●&lt;/font&gt;　&lt;font color=&quot;#FFB000&quot; size=&quot;6&quot;&gt;●&lt;/font&gt;　&lt;font color=&quot;#2468D8&quot; size=&quot;6&quot;&gt;●　…　●&lt;/font&gt;&lt;br&gt;&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;　 &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;　 &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;3&lt;/sub&gt;　 &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;4&lt;/sub&gt;　…　&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;m&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Consensus sign sequence along X&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;" parent="1" vertex="1"><mxGeometry x="875" y="1210" width="315" height="190" as="geometry"/></mxCell>

