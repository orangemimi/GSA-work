        <!-- 2. Gaussian weights -->
        <mxCell id="p2text" value="&lt;b&gt;2. Compute Gaussian weights&lt;/b&gt;&lt;br&gt;at each (&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;, &lt;i&gt;h&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;i&gt;w&lt;/i&gt;&lt;sub&gt;ij&lt;/sub&gt; = exp[−0.5 ((&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;i&lt;/sub&gt; − &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;) / &lt;i&gt;h&lt;/i&gt;)&lt;sup&gt;2&lt;/sup&gt;]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#111111;" parent="1" vertex="1"><mxGeometry x="55" y="310" width="330" height="145" as="geometry"/></mxCell>
