        <!-- 3. Local linear regression -->
        <mxCell id="p3text" value="&lt;b&gt;3. Fit local linear regression&lt;/b&gt;&lt;br&gt;at each (&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;, &lt;i&gt;h&lt;/i&gt;)&lt;br&gt;&lt;br&gt;&lt;i&gt;y&lt;/i&gt; = β&lt;sub&gt;0&lt;/sub&gt; + β&lt;sub&gt;1&lt;/sub&gt; (&lt;i&gt;x&lt;/i&gt; − &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;)&lt;br&gt;Local derivative: &lt;i&gt;f&lt;/i&gt;′(&lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;, &lt;i&gt;h&lt;/i&gt;) = β&lt;sub&gt;1&lt;/sub&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;fontColor=#111111;" parent="1" vertex="1"><mxGeometry x="55" y="550" width="330" height="165" as="geometry"/></mxCell>
