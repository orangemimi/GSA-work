        <!-- 6. Vote across bandwidths -->
        <mxCell id="p6text" value="&lt;b&gt;6. Vote across bandwidths&lt;/b&gt;&lt;br&gt;&lt;b&gt;　 at each &lt;i&gt;x&lt;/i&gt;&lt;sub&gt;j&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;(majority vote of signs&lt;br&gt;across all &lt;i&gt;h&lt;/i&gt;)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=17;" parent="1" vertex="1"><mxGeometry x="55" y="1208" width="270" height="150" as="geometry"/></mxCell>
