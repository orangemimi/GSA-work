        <mxCell id="f3lines" value="&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;k&lt;/sub&gt;　&lt;font color=&quot;#2468D8&quot;&gt;●━━━━●&lt;/font&gt;&lt;font color=&quot;#FFB000&quot;&gt;━━━━●&lt;/font&gt;&lt;font color=&quot;#FF2D2D&quot;&gt;━━━━●&lt;/font&gt;&lt;br&gt;　　　&lt;font color=&quot;#2468D8&quot;&gt;　●━━&lt;/font&gt;　　　&lt;font color=&quot;#FFB000&quot;&gt;●━━&lt;/font&gt;&lt;font color=&quot;#FF2D2D&quot;&gt;━━●&lt;/font&gt;&lt;br&gt;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt;　&lt;font color=&quot;#2468D8&quot;&gt;●━━━━●&lt;/font&gt;&lt;font color=&quot;#FFB000&quot;&gt;━━━━●&lt;/font&gt;&lt;font color=&quot;#FF2D2D&quot;&gt;━━●&lt;/font&gt;&lt;br&gt;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;　&lt;font color=&quot;#2468D8&quot;&gt;●━━●&lt;/font&gt;&lt;font color=&quot;#FFB000&quot;&gt;━━●━━●&lt;/font&gt;&lt;font color=&quot;#FF2D2D&quot;&gt;━━●&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;lineHeight=1.7;" parent="1" vertex="1"><mxGeometry x="875" y="1530" width="285" height="105" as="geometry"/></mxCell>
