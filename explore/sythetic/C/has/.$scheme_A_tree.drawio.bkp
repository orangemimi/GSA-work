        <mxCell id="m_L1" value="&lt;b style=&quot;color: rgb(108, 142, 191);&quot;&gt;Related metrics&lt;/b&gt;&lt;br&gt;• dcor — &lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;High → detect &amp;nbsp;|&amp;nbsp; Low → miss&lt;/span&gt;&lt;br&gt;• η² — &lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;High → detect &amp;nbsp;|&amp;nbsp; Low → miss&lt;/span&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#f0f4f8;align=left;verticalAlign=top;fontSize=10;rounded=1;whiteSpace=wrap;spacingLeft=6;spacingTop=4;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="130" y="152" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m_L2" value="&lt;b style=&#39;color:#6c8ebf&#39;&gt;Related metrics&lt;/b&gt;&lt;br&gt;• Pearson r — &lt;span style=&#39;color:#666&#39;&gt;(+) Positive &amp;nbsp;|&amp;nbsp; (−) Negative&lt;/span&gt;&lt;br&gt;• Spearman ρ — &lt;span style=&#39;color:#666&#39;&gt;(+) Positive &amp;nbsp;|&amp;nbsp; (−) Negative&lt;/span&gt;&lt;br&gt;&lt;i style=&#39;color:#999;font-size:9px&#39;&gt;Sign agreement → 4 labels: Pos / Neg / None / Mixed&lt;/i&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#f0f4f8;align=left;verticalAlign=top;fontSize=10;rounded=1;whiteSpace=wrap;spacingLeft=6;spacingTop=4;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="860" y="300" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m_L3" value="&lt;b style=&#39;color:#6c8ebf&#39;&gt;Related metrics&lt;/b&gt;&lt;br&gt;• |Spearman ρ| — &lt;span style=&#39;color:#666&#39;&gt;High / Med / Low → mono strength&lt;/span&gt;&lt;br&gt;• MAS — &lt;span style=&#39;color:#666&#39;&gt;High / Med / Low → mono strength&lt;/span&gt;&lt;br&gt;• 1st deriv sign changes — &lt;span style=&#39;color:#666&#39;&gt;0 = mono, ≥1 = non-mono&lt;/span&gt;&lt;br&gt;&lt;i style=&#39;color:#999;font-size:9px&#39;&gt;Combined → 5-level: Strong mono … Strong non-mono&lt;/i&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#f0f4f8;align=left;verticalAlign=top;fontSize=10;rounded=1;whiteSpace=wrap;spacingLeft=6;spacingTop=4;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="880" y="562" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_L4" value="&lt;b style=&#39;color:#6c8ebf&#39;&gt;Related metrics&lt;/b&gt;&lt;br&gt;• R² — &lt;span style=&#39;color:#666&#39;&gt;High / Med / Low → linear fit&lt;/span&gt;&lt;br&gt;• MIC — &lt;span style=&#39;color:#666&#39;&gt;High / Med / Low → association&lt;/span&gt;&lt;br&gt;• MIC − r² — &lt;span style=&#39;color:#666&#39;&gt;Low → linear, High → nonlinear&lt;/span&gt;&lt;br&gt;&lt;i style=&#39;color:#999;font-size:9px&#39;&gt;Combined → 5-level: Strongly linear … Strongly nonlinear&lt;/i&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#f0f4f8;align=left;verticalAlign=top;fontSize=10;rounded=1;whiteSpace=wrap;spacingLeft=6;spacingTop=4;spacingRight=6;" parent="1" vertex="1">
          <mxGeometry x="880" y="835" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_L5" value="&lt;b style=&#39;color:#6c8ebf&#39;&gt;Related metrics&lt;/b&gt;&lt;br&gt;• |r| − |ρ| gap — &lt;span style=&#39;color:#666&#39;&gt;Small / Med / Large → curvature strength&lt;/span&gt;&lt;br&gt;• Std slopes (early / late) — &lt;span style=&#39;color:#666&#39;&gt;ratio → Convex / Concave&lt;/span&gt;&lt;br&gt;&lt;i style=&#39;color:#999;font-size:9px&#39;&gt;Combined → 5-level + direction (Convex / Concave)&lt;/i&gt;" style="text;html=1;strokeColor=#cccccc;fillColor=#f0f4f8;align=left;verticalAlign=top;fontSize=10;rounded=1;whiteSpace=wrap;spacingLeft=6;spacingTop=4;spacingRight=6;" parent="1" vertex="1">
